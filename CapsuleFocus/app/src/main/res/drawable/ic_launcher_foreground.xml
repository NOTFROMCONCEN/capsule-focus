<?xml version="1.0" encoding="utf-8"?>
<!-- 构成主义 logo 矢量重建：圆环(番茄/呼吸) + 倾斜胶囊(灵动胶囊) + 红楔(专注推进)
     外层 group 缩放 0.62，把画面收进自适应图标安全区；红楔按原设计出血到角落 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.62"
        android:scaleY="0.62"
        android:pivotX="54"
        android:pivotY="54">

        <!-- 圆环 -->
        <path
            android:pathData="M24,54 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0 Z"
            android:strokeColor="#14110F"
            android:strokeWidth="3" />

        <!-- 红楔：左下刺入，尖端指向胶囊 -->
        <path
            android:pathData="M0,62 L44,68 L0,96 Z"
            android:fillColor="#E63328" />

        <!-- 胶囊：左红右黑，倾斜 15° -->
        <group
            android:rotation="15"
            android:pivotX="56"
            android:pivotY="50">
            <path
                android:pathData="M56,21 A13,13 0 0 0 43,34 L43,66 A13,13 0 0 0 56,79 A13,13 0 0 0 69,66 L69,34 A13,13 0 0 0 56,21 Z"
                android:fillColor="#14110F" />
            <path
                android:pathData="M56,21 A13,13 0 0 0 43,34 L43,66 A13,13 0 0 0 56,79 Z"
                android:fillColor="#E63328" />
        </group>
    </group>
</vector>
